#include <windows.h>
#include "resource.h"

1 24 "screensaver.manifest"

IDD_CONFIG DIALOGEX 0, 0, 448, 264
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "3D Text+"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_TABS, "SysTabControl32", WS_TABSTOP | TCS_MULTILINE, 6, 6, 250, 238
    CONTROL         "", IDC_PREVIEW, "Static", SS_BLACKFRAME, 264, 18, 178, 192
    CONTROL         "...", IDC_MENU_BUTTON, "Static", SS_NOTIFY | SS_RIGHT | SS_CENTERIMAGE, 424, 6, 18, 14
    DEFPUSHBUTTON   "OK",       IDOK,      264, 220, 56, 14
    PUSHBUTTON      "Cancelar", IDCANCEL,  326, 220, 56, 14
    PUSHBUTTON      "Aplicar",  IDC_APPLY, 386, 220, 56, 14

    LTEXT           "Preset:", IDC_PRESET_LABEL, 6, 248, 40, 7
    COMBOBOX        IDC_PRESET_COMBO, 50, 246, 150, 80, CBS_DROPDOWNLIST | WS_TABSTOP
    PUSHBUTTON      "+", IDC_PRESET_SAVE,   206, 246, 18, 14
    PUSHBUTTON      "-", IDC_PRESET_DELETE, 226, 246, 18, 14
END

IDD_PRESET_NAME DIALOGEX 0, 0, 200, 62
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Nome do preset"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT         "Nome:", IDC_PRESET_NAME_LABEL, 8, 10, 184, 9
    EDITTEXT      IDC_PRESET_NAME_EDIT, 8, 22, 184, 14, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "OK",       IDOK,     70, 42, 56, 14
    PUSHBUTTON    "Cancelar", IDCANCEL, 132, 42, 56, 14
END

IDD_ABOUT DIALOGEX 0, 0, 220, 108
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Sobre"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT      "3D Text+", IDC_ABOUT_NAME, 10, 10, 200, 12
    LTEXT      "", IDC_ABOUT_VERSION, 10, 28, 200, 9
    LTEXT      "Alan Maziero", IDC_ABOUT_AUTHOR, 10, 42, 200, 9
    CONTROL    "<a>github.com/alanmm/modern3dtext</a>", IDC_ABOUT_LINK, "SysLink", WS_TABSTOP, 10, 58, 200, 12
    DEFPUSHBUTTON "OK", IDOK, 82, 86, 56, 14
END

IDD_TAB_CONTENT DIALOGEX 0, 0, 240, 200
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Modo:", IDC_MODE_LABEL, 8, 10, 60, 9
    COMBOBOX        IDC_CONTMODE, 68, 8, 100, 60, CBS_DROPDOWNLIST | WS_TABSTOP

    LTEXT           "Texto:", IDC_TEXTLABEL, 8, 30, 60, 9
    EDITTEXT        IDC_TEXT, 8, 42, 224, 40,
                    ES_MULTILINE | ES_WANTRETURN | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Fonte:", IDC_FONTLABEL, 8, 92, 60, 9
    COMBOBOX        IDC_FONT, 8, 104, 224, 160,
                    CBS_DROPDOWNLIST | CBS_SORT | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Arquivo:", IDC_SVGPATHLABEL, 8, 42, 60, 9
    LTEXT           "(nenhum)", IDC_SVGPATH, 8, 54, 224, 9, SS_PATHELLIPSIS
    PUSHBUTTON      "Escolher...", IDC_SVGPICK, 8, 66, 60, 14
    PUSHBUTTON      "Limpar", IDC_SVGCLEAR, 72, 66, 50, 14
    LTEXT           "Cores:", IDC_SVGCOLORLABEL, 8, 92, 60, 9
    COMBOBOX        IDC_SVGCOLORMODE, 68, 90, 164, 60, CBS_DROPDOWNLIST | WS_TABSTOP

    LTEXT           "Arquivo:", IDC_MESHPATHLABEL, 8, 42, 60, 9
    LTEXT           "(nenhum)", IDC_MESHPATH, 8, 54, 224, 9, SS_PATHELLIPSIS
    PUSHBUTTON      "Escolher...", IDC_MESHPICK, 8, 66, 60, 14
    PUSHBUTTON      "Limpar", IDC_MESHCLEAR, 72, 66, 50, 14
    LTEXT           "Escala:", IDC_MESHSCALELABEL, 8, 92, 60, 9
    LTEXT           "", IDC_MESHSCALE_VAL, 182, 92, 50, 9
    CONTROL         "", IDC_MESHSCALE, "msctls_trackbar32", WS_TABSTOP | TBS_HORZ, 8, 102, 224, 16
    AUTOCHECKBOX     "Usar materiais do arquivo", IDC_MESHUSEMAT, 8, 119, 180, 9

    AUTOCHECKBOX     "Negrito", IDC_BOLD,   8, 128, 60, 12
    AUTOCHECKBOX     "Italico", IDC_ITALIC, 76, 128, 60, 12
    AUTOCHECKBOX     "Mostrar data", IDC_CLOCKDATE, 130, 128, 100, 12
    LTEXT           "Cor:", IDC_COLOR_LABEL, 8, 150, 60, 9
    PUSHBUTTON      "Escolher cor...", IDC_COLOR, 8, 162, 90, 14
    AUTOCHECKBOX     "Mostrar segundos", IDC_CLOCKSEC, 130, 144, 110, 12
END

IDD_TAB_MOTION DIALOGEX 0, 0, 240, 200
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT    "Angulo max. (graus):", IDC_ANGLE_LABEL, 8, 10, 110, 9
    LTEXT    "", IDC_ANGLE_VAL, 182, 10, 50, 9
    CONTROL  "", IDC_ANGLE, "msctls_trackbar32", WS_TABSTOP | TBS_HORZ, 8, 20, 224, 18
    LTEXT    "Inclinacao X (graus):", IDC_TILT_LABEL, 8, 44, 110, 9
    LTEXT    "", IDC_TILT_VAL, 182, 44, 50, 9
    CONTROL  "", IDC_TILT, "msctls_trackbar32", WS_TABSTOP | TBS_HORZ, 8, 54, 224, 18
    LTEXT    "Periodo (s):", IDC_PERIOD_LABEL, 8, 78, 90, 9
    LTEXT    "", IDC_PERIOD_VAL, 182, 78, 50, 9
    CONTROL  "", IDC_PERIOD, "msctls_trackbar32", WS_TABSTOP | TBS_HORZ, 8, 88, 224, 18
END

IDD_TAB_MATERIAL DIALOGEX 0, 0, 240, 200
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT      "Material:", IDC_MATERIAL_LABEL, 8, 10, 60, 9
    COMBOBOX   IDC_MATMODE, 8, 22, 150, 80, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT      "Metalizacao:", IDC_METAL_LABEL, 8, 46, 90, 9
    LTEXT      "", IDC_METAL_VAL, 182, 46, 50, 9
    CONTROL    "", IDC_METAL, "msctls_trackbar32", WS_TABSTOP | TBS_HORZ, 8, 56, 224, 18
    LTEXT      "Rugosidade:", IDC_ROUGH_LABEL, 8, 80, 90, 9
    LTEXT      "", IDC_ROUGH_VAL, 182, 80, 50, 9
    CONTROL    "", IDC_ROUGH, "msctls_trackbar32", WS_TABSTOP | TBS_HORZ, 8, 90, 224, 18
    LTEXT      "Imagem de ambiente:", IDC_ENV_LABEL, 8, 116, 200, 9
    CONTROL    "Embutida", IDC_ENVMODE_EMBED, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 8, 128, 62, 10
    CONTROL    "Personalizada", IDC_ENVMODE_CUSTOM, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 74, 128, 78, 10
    CONTROL    "Nenhuma", IDC_ENVMODE_NONE, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 156, 128, 60, 10
    LTEXT      "(procedural)", IDC_ENVPATH, 8, 142, 224, 9, SS_PATHELLIPSIS
    PUSHBUTTON "Escolher...", IDC_ENVPICK, 8, 154, 60, 14
    PUSHBUTTON "Limpar",      IDC_ENVCLEAR, 72, 154, 50, 14
END

IDD_TAB_GEOMETRY DIALOGEX 0, 0, 240, 200
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT      "Profundidade:", IDC_DEPTH_LABEL, 8, 8, 90, 9
    LTEXT      "", IDC_DEPTH_VAL, 182, 8, 50, 9
    CONTROL    "", IDC_DEPTH, "msctls_trackbar32", WS_TABSTOP | TBS_HORZ, 8, 18, 224, 16
    LTEXT      "Bevel:", IDC_BEVEL_LABEL, 8, 36, 50, 9
    COMBOBOX   IDC_BEVELMODE, 64, 34, 140, 80, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT      "Tamanho:", IDC_BSIZE_LABEL, 8, 52, 90, 9
    LTEXT      "", IDC_BSIZE_VAL, 182, 52, 50, 9
    CONTROL    "", IDC_BSIZE, "msctls_trackbar32", WS_TABSTOP | TBS_HORZ, 8, 62, 224, 16
    LTEXT      "Profundidade do chanfro:", IDC_BDEPTH_LABEL, 8, 80, 120, 9
    LTEXT      "", IDC_BDEPTH_VAL, 182, 80, 50, 9
    CONTROL    "", IDC_BDEPTH, "msctls_trackbar32", WS_TABSTOP | TBS_HORZ, 8, 90, 224, 16
    LTEXT      "Segmentos (modo geometrico):", IDC_BSEG_LABEL, 8, 108, 130, 9
    LTEXT      "", IDC_BSEG_VAL, 182, 108, 50, 9
    CONTROL    "", IDC_BSEG, "msctls_trackbar32", WS_TABSTOP | TBS_HORZ, 8, 118, 224, 16
    AUTOCHECKBOX "Casca oca", IDC_SHELL, 8, 138, 80, 12
    LTEXT      "Espessura da parede:", IDC_WALL_LABEL, 8, 154, 110, 9
    LTEXT      "", IDC_WALL_VAL, 182, 154, 50, 9
    CONTROL    "", IDC_WALL, "msctls_trackbar32", WS_TABSTOP | TBS_HORZ, 8, 164, 224, 16
    LTEXT      "Qualidade:", IDC_QUALITY_LABEL, 8, 184, 60, 9
    COMBOBOX   IDC_QUALITY, 72, 182, 90, 80, CBS_DROPDOWNLIST | WS_TABSTOP
END

IDD_TAB_EFFECTS DIALOGEX 0, 0, 240, 200
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    AUTOCHECKBOX "Bloom (glare)", IDC_BLOOM, 8, 8, 120, 12
    LTEXT      "Limiar (bloom e streaks):", IDC_BTHRESH_LABEL, 8, 24, 140, 9
    LTEXT      "", IDC_BTHRESH_VAL, 182, 24, 50, 9
    CONTROL    "", IDC_BTHRESH, "msctls_trackbar32", WS_TABSTOP | TBS_HORZ, 8, 33, 224, 14
    LTEXT      "Intensidade:", IDC_BINT_LABEL, 8, 49, 80, 9
    LTEXT      "", IDC_BINT_VAL, 182, 49, 50, 9
    CONTROL    "", IDC_BINT, "msctls_trackbar32", WS_TABSTOP | TBS_HORZ, 8, 58, 224, 14
    LTEXT      "Espalhamento:", IDC_BRAD_LABEL, 8, 74, 80, 9
    LTEXT      "", IDC_BRAD_VAL, 182, 74, 50, 9
    CONTROL    "", IDC_BRAD, "msctls_trackbar32", WS_TABSTOP | TBS_HORZ, 8, 83, 224, 14

    LTEXT      "Streaks (difracao):", IDC_STREAKS_LABEL, 8, 106, 90, 9
    COMBOBOX   IDC_STREAKMODE, 100, 104, 100, 80, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT      "Intensidade:", IDC_SINT_LABEL, 8, 124, 80, 9
    LTEXT      "", IDC_SINT_VAL, 182, 124, 50, 9
    CONTROL    "", IDC_SINT, "msctls_trackbar32", WS_TABSTOP | TBS_HORZ, 8, 133, 224, 14
    LTEXT      "Comprimento:", IDC_SLEN_LABEL, 8, 149, 80, 9
    LTEXT      "", IDC_SLEN_VAL, 182, 149, 50, 9
    CONTROL    "", IDC_SLEN, "msctls_trackbar32", WS_TABSTOP | TBS_HORZ, 8, 158, 224, 14
    LTEXT      "", IDC_EFFECTS_HINT, 8, 174, 224, 24
END

IDD_TAB_PERF DIALOGEX 0, 0, 240, 200
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT      "Limite de FPS:", IDC_FPS_LABEL, 8, 10, 90, 9
    COMBOBOX   IDC_FPSCAP, 100, 8, 90, 80, CBS_DROPDOWNLIST | WS_TABSTOP
    AUTOCHECKBOX "VSync", IDC_VSYNC, 8, 30, 120, 12
    LTEXT      "Anti-serrilhado (MSAA):", IDC_MSAA_LABEL, 8, 50, 110, 9
    COMBOBOX   IDC_MSAA, 120, 48, 70, 80, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT      "Escala de render:", IDC_RSCALE_LABEL, 8, 72, 90, 9
    LTEXT      "", IDC_RSCALE_VAL, 182, 72, 50, 9
    CONTROL    "", IDC_RSCALE, "msctls_trackbar32", WS_TABSTOP | TBS_HORZ, 8, 82, 224, 18
    AUTOCHECKBOX "Qualidade automatica", IDC_AUTOQ, 8, 108, 160, 12
    LTEXT      "Com a qualidade automatica ligada os valores acima sao o ponto de partida; o screensaver reduz sozinho se a GPU nao acompanhar.",
               IDC_PERF_HINT, 8, 124, 224, 32
END

IDD_TAB_POST DIALOGEX 0, 0, 240, 200
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    AUTOCHECKBOX "Aberracao cromatica", IDC_CHROMA, 8, 8, 160, 12
    LTEXT      "Intensidade:", IDC_CSTR_LABEL, 8, 24, 80, 9
    LTEXT      "", IDC_CSTR_VAL, 182, 24, 50, 9
    CONTROL    "", IDC_CSTR, "msctls_trackbar32", WS_TABSTOP | TBS_HORZ, 8, 33, 224, 14

    AUTOCHECKBOX "Vinheta", IDC_VIGNETTE, 8, 55, 160, 12
    LTEXT      "Intensidade:", IDC_VAMT_LABEL, 8, 71, 80, 9
    LTEXT      "", IDC_VAMT_VAL, 182, 71, 50, 9
    CONTROL    "", IDC_VAMT, "msctls_trackbar32", WS_TABSTOP | TBS_HORZ, 8, 80, 224, 14

    AUTOCHECKBOX "FXAA (anti-serrilhado)", IDC_FXAA, 8, 102, 200, 12

    LTEXT      "", IDC_POST_HINT, 8, 124, 224, 20
END

IDD_TAB_BG DIALOGEX 0, 0, 240, 200
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT      "Tipo de fundo:", IDC_BGTYPE_LABEL, 8, 10, 90, 9
    COMBOBOX   IDC_BGTYPE, 100, 8, 132, 80, CBS_DROPDOWNLIST | WS_TABSTOP

    LTEXT      "Cor 1:", IDC_BGCOLOR1_LABEL, 8, 30, 60, 9
    PUSHBUTTON "Escolher cor...", IDC_BGCOLOR1, 100, 28, 100, 14
    LTEXT      "Cor 2:", IDC_BGCOLOR2_LABEL, 8, 48, 60, 9
    PUSHBUTTON "Escolher cor...", IDC_BGCOLOR2, 100, 46, 100, 14

    LTEXT      "Angulo do gradiente (graus):", IDC_BGANGLE_LABEL, 8, 66, 140, 9
    LTEXT      "", IDC_BGANGLE_VAL, 182, 66, 50, 9
    CONTROL    "", IDC_BGANGLE, "msctls_trackbar32", WS_TABSTOP | TBS_HORZ, 8, 76, 224, 16

    LTEXT      "Imagem de fundo:", IDC_BGIMAGE_LABEL, 8, 96, 200, 9
    LTEXT      "(nenhuma)", IDC_BGIMGPATH, 8, 108, 224, 9, SS_PATHELLIPSIS
    PUSHBUTTON "Escolher...", IDC_BGIMGPICK, 8, 120, 60, 14
    PUSHBUTTON "Limpar",      IDC_BGIMGCLEAR, 72, 120, 50, 14
    LTEXT      "Ajuste:", IDC_BGFIT_LABEL, 128, 122, 34, 9
    COMBOBOX   IDC_BGFIT, 162, 120, 70, 60, CBS_DROPDOWNLIST | WS_TABSTOP

    LTEXT      "Velocidade de pan:", IDC_BGPAN_LABEL, 8, 140, 110, 9
    LTEXT      "", IDC_BGPAN_VAL, 182, 140, 50, 9
    CONTROL    "", IDC_BGPAN, "msctls_trackbar32", WS_TABSTOP | TBS_HORZ, 8, 150, 224, 16

    LTEXT      "Nebulosa:", IDC_BGNEBULA_LABEL, 8, 172, 50, 9
    PUSHBUTTON "Cor 1...", IDC_BGNEBCOLOR1, 60, 170, 80, 14
    PUSHBUTTON "Cor 2...", IDC_BGNEBCOLOR2, 144, 170, 80, 14
END

IDD_TAB_PARTICLES DIALOGEX 0, 0, 240, 200
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    AUTOCHECKBOX "Ativar particulas", IDC_PARTON, 8, 8, 140, 12

    LTEXT      "Tipo:", IDC_PARTKIND_LABEL, 8, 28, 40, 9
    COMBOBOX   IDC_PARTKIND, 60, 26, 140, 80, CBS_DROPDOWNLIST | WS_TABSTOP

    LTEXT      "Densidade:", IDC_PARTDENS_LABEL, 8, 48, 80, 9
    LTEXT      "", IDC_PARTDENS_VAL, 182, 48, 50, 9
    CONTROL    "", IDC_PARTDENS, "msctls_trackbar32", WS_TABSTOP | TBS_HORZ, 8, 58, 224, 16

    LTEXT      "Velocidade:", IDC_PARTSPEED_LABEL, 8, 78, 80, 9
    LTEXT      "", IDC_PARTSPEED_VAL, 182, 78, 50, 9
    CONTROL    "", IDC_PARTSPEED, "msctls_trackbar32", WS_TABSTOP | TBS_HORZ, 8, 88, 224, 16

    LTEXT      "Tamanho:", IDC_PARTSIZE_LABEL, 8, 108, 80, 9
    LTEXT      "", IDC_PARTSIZE_VAL, 182, 108, 50, 9
    CONTROL    "", IDC_PARTSIZE, "msctls_trackbar32", WS_TABSTOP | TBS_HORZ, 8, 118, 224, 16

    LTEXT      "Opacidade:", IDC_PARTOPACITY_LABEL, 8, 138, 80, 9
    LTEXT      "", IDC_PARTOPACITY_VAL, 182, 138, 50, 9
    CONTROL    "", IDC_PARTOPACITY, "msctls_trackbar32", WS_TABSTOP | TBS_HORZ, 8, 148, 224, 16
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    0,4,3,0
 PRODUCTVERSION 0,4,3,0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "Alan Maziero"
      VALUE "FileDescription",  "3D Text+ Screensaver"
      VALUE "FileVersion",      "0.4.3.0"
      VALUE "InternalName",     "Modern3DText"
      VALUE "OriginalFilename", "Modern3DText.scr"
      VALUE "ProductName",      "3D Text+"
      VALUE "ProductVersion",   "0.4.3.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
